class Node{
    int key;
    int val;
    Node prev;
    Node next;

    public Node(int key,int val){
        this.key=key;
        this.val=val;
        this.next=null;
        this.prev=null;
    }
}

class LRUCache{
    
    //this stores key -> node in dll
    Map<Integer,Node> mp;
    int capacity;
    Node head,tail;

    public LRUCache(int capacity){
        
        this.capacity = capacity;
        head=new Node(0,0);
        tail=new Node(0,0);
        
        head.next=tail;
        tail.prev=head;

        mp=new HashMap<>();
    }

   public void addToHead(Node node){
        
        node.next=head.next;
        node.prev=head;

        head.next.prev=node;
        head.next = node; 
        
   }

   public void removeFromTail(){

         Node lru = tail.prev;

         removeNode(lru);
         mp.remove(lru.key);


   }

   public void removeNode(Node node){
        node.prev.next = node.next;
        node.next.prev=node.prev;
   }


    public int get(int key) {

         //node is not present

         if(!mp.containsKey(key))
           return -1;

        //if node is present
        Node node = mp.get(key);

        removeNode(node);
        addToHead(node);

        return node.val;
        
    }
    
    public void put(int key, int value) {
        
       //alredy exists -> still update the key,move tom front
       if(mp.containsKey(key)){
            
            Node node = mp.get(key);

            removeNode(node);

            node.val=value;
            addToHead(node);
            
       }

       //doesnt exists
        //    - check capcity hit
        //    - Yes -> Reove from end and add to head

        //    - No -> add to font
        
        else{
        Node node = new Node(key,value);
        mp.put(key,node);

        if(capacity+1 ==  mp.size()){
            
            //remove from tail
            //add to front

            removeFromTail();
            addToHead(node);
        }

        else{
             
             addToHead(node);
        }
        }

    }



}



